/*.log
build/
*.d
*.o
*.a
/.idea

# Cross-compile toolchains, downloaded by scripts/setup-toolchain.sh
/toolchains/

# Release packaging output from release.sh
/releases/
/*.tar.gz
/*.tar.bz2
/*.tar.xz

# Local editor and tooling state
/compile_commands.json
/.cache/
/.vscode/
/.claude/settings.local.json

# Local build config that should never be shared. The simulator writes its
# runtime config next to the binary, but keep a stray copy at the root ignored
# too since it can carry a printer IP.
/guppyconfig.json

# Records which target the vendored libs were last built for
/.vendor-target

# Records which flags the objects were last built with
/.build-flags

# Python bytecode from running the klippy modules or scripts locally
__pycache__/
*.pyc
